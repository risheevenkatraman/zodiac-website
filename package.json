{
  "name": "zodiac-website",
  "private": true,
  "scripts": {
    "dev": "npm run typecheck && node scripts/prepare-next.cjs && next dev",
    "build": "npm run typecheck && node scripts/prepare-next.cjs && next build && node scripts/export-aliases.cjs",
    "start": "node scripts/serve-export.cjs",
    "format": "node scripts/format.cjs",
    "format:check": "node scripts/format.cjs --check",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:watch": "next typegen && tsc --noEmit --watch"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.6.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
